# =============================================================================
#  Copy this file to ".env"  (same folder as docker-compose.yml) and edit it.
#      PowerShell:  Copy-Item .env.example .env
#  ".env" is listed in .gitignore — never commit your real tunnel token.
# =============================================================================

# --- Local port on your Windows machine --------------------------------------
# The site will be reachable on this PC at http://localhost:8080
# If 8080 is busy (other dev servers, IIS, ...), change it to e.g. 8090.
WEB_PORT=8080

# --- Only needed for the Named Tunnel (profile "named") ----------------------
# Cloudflare Zero Trust dashboard:
#   Networks -> Tunnels -> Create a tunnel -> Cloudflared -> (name it)
#   -> Save tunnel -> "Install connector" -> choose Docker tab
#   -> copy ONLY the long token that comes after "--token"
# It looks like: eyJhIjoi...  (one long line, no spaces, no quotes)
#
# Leave it empty if you are only using the Quick Tunnel (profile "quick").
CLOUDFLARE_TUNNEL_TOKEN=
